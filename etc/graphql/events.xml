<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="controller_front_send_response_before">
        <observer name="kingletas_catalog_index_flush_read_metrics" instance="Kingletas\CatalogIndex\Observer\FlushReadMetrics"/>
    </event>
    <event name="eav_collection_abstract_load_before">
        <observer name="kingletas_catalog_index_skip_document_attributes" instance="Kingletas\CatalogIndex\Observer\Read\SkipDocumentAttributes"/>
    </event>
    <event name="catalog_product_collection_load_after">
        <observer name="kingletas_catalog_index_fill_document_attributes" instance="Kingletas\CatalogIndex\Observer\Read\FillDocumentAttributes"/>
    </event>
</config>
