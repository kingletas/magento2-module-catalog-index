<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_success">
        <observer name="kingletas_catalog_index_order_placed" instance="Kingletas\CatalogIndex\Observer\RefreshOrderedProducts"/>
    </event>
    <event name="order_cancel_after">
        <observer name="kingletas_catalog_index_order_cancelled" instance="Kingletas\CatalogIndex\Observer\RefreshOrderedProducts"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="kingletas_catalog_index_order_refunded" instance="Kingletas\CatalogIndex\Observer\RefreshOrderedProducts"/>
    </event>
    <event name="catalog_product_save_commit_after">
        <observer name="kingletas_catalog_index_product_saved" instance="Kingletas\CatalogIndex\Observer\RefreshSavedProduct"/>
    </event>
    <event name="catalog_product_delete_commit_after">
        <observer name="kingletas_catalog_index_product_deleted" instance="Kingletas\CatalogIndex\Observer\RefreshSavedProduct"/>
    </event>
    <event name="catalog_entity_attribute_save_after">
        <observer name="kingletas_catalog_index_attribute_saved" instance="Kingletas\CatalogIndex\Observer\RefreshSuperAttributeProducts"/>
    </event>
    <event name="catalog_category_save_commit_after">
        <observer name="kingletas_catalog_index_category_saved" instance="Kingletas\CatalogIndex\Observer\RefreshSavedCategory"/>
    </event>
    <event name="catalog_category_delete_commit_after">
        <observer name="kingletas_catalog_index_category_deleted" instance="Kingletas\CatalogIndex\Observer\RefreshSavedCategory"/>
    </event>
</config>
